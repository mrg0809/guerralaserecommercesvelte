# Supabase Configuration
PUBLIC_SUPABASE_URL=your-supabase-url
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Envia.com API
VITE_ENVIA_API_TOKEN=your_envia_api_token

# Nesting + vectorización imagen→DXF/PLT (mismo FastAPI; token = NESTING_TOKEN; docker compose: puerto 8002)
NESTING_API_URL=http://localhost:8002
NESTING_API_TOKEN=your-nesting-service-token
